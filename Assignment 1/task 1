
class Vehicle {
    String regNo, type;

    Vehicle(String regNo, String type) {
        this.regNo = regNo;
        this.type = type;
    }

    void display() {
        System.out.println(regNo + " " + type);
    }
}

class ParkingSlot {
    int slotNo;
    boolean occupied;

    ParkingSlot(int slotNo) {
        this.slotNo = slotNo;
        occupied = false;
    }
}

public class Task01 {
    public static void main(String[] args) {
        Vehicle v = new Vehicle("TN01AB1111", "Car");
        ParkingSlot s = new ParkingSlot(101);

        v.display();

        System.out.println("Slot: " + s.slotNo);
        System.out.println("Occupied: " + s.occupied);
    }
}
